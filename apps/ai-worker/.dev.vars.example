# Copy to `.dev.vars` for `wrangler dev`. `.dev.vars` is gitignored and must
# never be committed (brief section 12). This example file contains no real
# credentials.
#
# Non-secret values also live in `wrangler.jsonc` under `vars`, which is what a
# deployed Worker uses. `.dev.vars` overrides them locally.
#
# SECRET?  | variable
# ---------|---------------------------------------------------------------
#  no      | AI_PROVIDER, STT_MODEL,
#          | ALLOWED_ORIGINS, SUPABASE_URL, SUPABASE_JWT_ISSUER,
#          | MAX_* limits, RATE_LIMIT_PER_MINUTE, LOG_LEVEL
#  YES     | SUPABASE_JWT_SECRET   (set in production with
#          |                        `npx wrangler secret put SUPABASE_JWT_SECRET`)
#
# The Worker needs NO Supabase service-role key. It never writes to the database;
# the browser saves approved drafts through RLS-protected APIs.

# --- Provider selection (NOT a secret) ---------------------------------------
# `mock`       deterministic, offline, no Cloudflare account required
# `cloudflare` real Workers AI via the `AI` binding
AI_PROVIDER=mock

# --- Model IDs (NOT secrets; configuration only) -----------------------------
# UNVERIFIED. These are the brief's stated preferences and could NOT be checked
# against Cloudflare's live catalogue (no account yet). Before the first deploy,
# confirm they are current and non-deprecated at
# https://developers.cloudflare.com/workers-ai/models/ and that the parser model
# still supports JSON Mode / schema-constrained output. Swap in a current
# non-deprecated open-weight model if not.
STT_MODEL=@cf/openai/whisper-large-v3-turbo

# --- CORS (NOT a secret) -----------------------------------------------------
# Comma-separated exact origins. No wildcards. A request whose `Origin` is not
# listed is rejected with 403 forbidden_origin, and so is a /v1 request with no
# `Origin` at all — pass `-H "Origin: http://localhost:5173"` when testing with
# curl.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase auth -----------------------------------------------------------
# Project URL (NOT a secret). Used to derive the JWKS URL
# `${SUPABASE_URL}/auth/v1/.well-known/jwks.json` and the expected issuer.
SUPABASE_URL=http://127.0.0.1:54321

# Optional override (NOT a secret). Defaults to `${SUPABASE_URL}/auth/v1`.
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# SECRET. Only used for the symmetric HS256 fallback, which is the path local
# Supabase takes. Projects on asymmetric signing keys need no secret: the Worker
# verifies against the public JWKS instead.
#
# The value below is the well-known, publicly documented local-development
# default that `supabase start` prints. It is NOT a credential — never reuse it
# for a hosted project, and set the real one with `wrangler secret put`.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Limits (NOT secrets) ----------------------------------------------------
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=300
RATE_LIMIT_PER_MINUTE=30

# `debug` logs request metadata only. Bearer tokens, raw audio and transcript
# text are never logged at any level.
LOG_LEVEL=info
