{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "training-ai-worker",
  "main": "src/index.ts",
  // Keep in step with the repo's Node/TS baseline; nodejs_compat is not needed
  // because the Worker uses only Web APIs.
  "compatibility_date": "2025-06-01",
  "observability": {
    "enabled": true,
  },
  // Workers AI. Exposed to code as `env.AI` (brief 7.4). This is the only
  // binding the Worker has: it deliberately has no Supabase service-role key and
  // no database access, because it never writes approved records.
  "ai": {
    "binding": "AI",
  },
  "vars": {
    // --- Non-secret configuration -------------------------------------------
    // `cloudflare` | `mock`. Tests and previews use `mock`, which needs no
    // Cloudflare account and makes no network calls.
    "AI_PROVIDER": "cloudflare",

    // Model IDs are configuration, never business logic. Change them here (or
    // per environment) when Cloudflare's catalogue moves.
    //
    // UNVERIFIED: these two IDs are the brief's stated *preferences*. They could
    // not be checked against Cloudflare's live model catalogue because this repo
    // has no Cloudflare account yet. Before the first deploy, confirm both are
    // current and non-deprecated at
    // https://developers.cloudflare.com/workers-ai/models/ and that the parser
    // model still supports JSON Mode / schema-constrained output. `GET /health`
    // echoes whatever is configured here so a mismatch is visible immediately.
    "STT_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "WORKOUT_PARSER_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "PLANNER_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",

    // Comma-separated CORS allowlist. Replace with the deployed PWA origin.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",

    // Supabase project URL, used to derive the JWKS endpoint and the expected
    // token issuer. Not a secret.
    "SUPABASE_URL": "http://127.0.0.1:54321",

    // Limits (brief 7.2 step 3). Empty/absent falls back to the shared defaults
    // in @training/ai-contracts.
    "MAX_JSON_BODY_BYTES": "131072",
    "MAX_AUDIO_BYTES": "10485760",
    "MAX_AUDIO_SECONDS": "300",
    "MAX_TEXT_CHARS": "12000",
    "RATE_LIMIT_PER_MINUTE": "30",
  },
  // --- Secrets ---------------------------------------------------------------
  // Never listed here. Set with:
  //   npx wrangler secret put SUPABASE_JWT_SECRET
  // Only needed for projects still on symmetric HS256 signing keys (local
  // Supabase is one). Asymmetric projects need no secret at all: the Worker
  // fetches the public JWKS from SUPABASE_URL.
}
