# The bare project URL — no path, no trailing slash. Not the REST endpoint:
# supabase-js appends `auth/v1` and `rest/v1` itself, so a `/rest/v1` suffix here
# sends sign-in to /rest/v1/auth/v1/token and every login fails with PGRST125.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 4: the deployed Cloudflare Worker URL. Leave blank to disable voice.
VITE_AI_WORKER_URL=
