# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dev-dist/
*.tsbuildinfo

# Secrets — never commit populated env files
.env
.env.*
!.env.example
!**/.env.import.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Python
.venv/
__pycache__/
*.pyc

# Personal health data — the source workbook is never committed.
# Its identity is pinned by data/source/MANIFEST.sha256 instead.
#
# NOTE: these use the `dir/*` form, not `dir/`. Excluding the directory itself
# would stop git descending into it, and the `!` negations below would never be
# evaluated.
data/source/*
!data/source/MANIFEST.sha256
data/staging/*
!data/staging/.gitkeep

# Generated import artefacts.
#
# The split is by CONTENT, not by file type. The workbook profile is pure
# structure and counts — no training text — and Phase 0 requires it committed.
# The reconciliation report and the review queue quote raw source lines
# verbatim, which is personal health data, so they stay local like the
# workbook itself. Both are regenerated on demand by the pipeline.
docs/reports/import-reconciliation.md
docs/reports/review-queue.json
docs/reports/*.local.*

# Playwright artefacts. Traces and screenshots of the signed-in app contain
# real training data, so they stay local like the workbook itself.
test-results/
playwright-report/
.playwright/

# Supabase local state
supabase/.temp/
supabase/.branches/

# OS
.DS_Store
