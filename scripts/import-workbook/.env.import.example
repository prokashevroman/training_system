# WARNING: never commit a populated .env.import. The service role key bypasses
# Row Level Security and can read/write any row. Keep this file local-only.
#
# These are deliberately NOT VITE_-prefixed: the importer runs in Node on a
# trusted machine, and a VITE_ prefix would make them eligible for a browser
# bundle.
#
# Local Supabase (`supabase start` prints these):
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY=<"service_role key" from `supabase status`>
#
# IMPORT_USER_ID is the auth.users UUID that will own every imported row.
# Create it once with `supabase auth` or the Studio UI, then paste it here.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IMPORT_USER_ID=
